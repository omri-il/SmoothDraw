    <Geometry x:Key="Icon.Arrow">M17 7l-10 10 M8 7l9 0l0 9</Geometry>
    <!-- rectangle -->
    <Geometry x:Key="Icon.Rectangle">M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10</Geometry>
    <!-- circle -->
    <Geometry x:Key="Icon.Circle">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0</Geometry>
    <!-- typography -->
    <Geometry x:Key="Icon.Text">M4 20l3 0 M14 20l7 0 M6.9 15l6.9 0 M10.2 6.3l5.8 13.7 M5 20l6 -16l2 0l7 16</Geometry>
    <!-- arrow-back-up -->
    <Geometry x:Key="Icon.Undo">M9 14l-4 -4l4 -4 M5 10h11a4 4 0 1 1 0 8h-1</Geometry>
    <!-- arrow-forward-up -->
    <Geometry x:Key="Icon.Redo">M15 14l4 -4l-4 -4 M19 10h-11a4 4 0 1 0 0 8h1</Geometry>
    <!-- confetti -->
    <Geometry x:Key="Icon.Confetti">M4 5h2 M5 4v2 M11.5 4l-.5 2 M18 5h2 M19 4v2 M15 9l-1 1 M18 13l2 -.5 M18 19h2 M19 18v2 M14 16.518l-6.518 -6.518l-4.39 9.58a1 1 0 0 0 1.329 1.329l9.579 -4.39</Geometry>
