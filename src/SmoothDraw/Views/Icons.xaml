    <!-- pencil -->
    <Geometry x:Key="Icon.Pen">M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4 M13.5 6.5l4 4</Geometry>
    <!-- highlight -->
    <Geometry x:Key="Icon.Highlighter">M3 19h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4 M12.5 5.5l4 4 M4.5 13.5l4 4 M21 15v4h-8l4 -4l4 0</Geometry>
