    <Geometry x:Key="Icon.Trash">M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3</Geometry>
    <!-- x -->
    <Geometry x:Key="Icon.Close">M18 6l-12 12 M6 6l12 12</Geometry>

    <!-- An icon above as a button's content: 20 px, in the button's Foreground -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="20" Height="20">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
