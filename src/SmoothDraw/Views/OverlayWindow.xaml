<Window x:Class="SmoothDraw.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmoothDraw.Views"
        Title="SmoothDraw"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid>
        <!-- The board (F5): an empty page over the whole screen, under the drawing. Its
             colour is the settings' BoardColor -->
        <Rectangle x:Name="Board"
                   Fill="#121417"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>

        <!-- Ink drawing layer (Pen, Highlighter, Eraser, Laser) -->
        <local:PenInkCanvas x:Name="DrawCanvas"
                   Background="Transparent"
                   EditingMode="None"
                   UseCustomCursor="False">
            <local:PenInkCanvas.DefaultDrawingAttributes>
                <DrawingAttributes Color="Red" Width="3" Height="3"
                                   FitToCurve="True" StylusTip="Ellipse"
                                   IgnorePressure="False"/>
            </local:PenInkCanvas.DefaultDrawingAttributes>
        </local:PenInkCanvas>

        <!-- Shape drawing layer (Arrow, Rectangle, Circle, Text) -->
        <Canvas x:Name="ShapeCanvas"
                Background="Transparent"
                IsHitTestVisible="False"/>

        <!-- Stopwatch HUD -->
        <Border x:Name="TimerContainer"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20"
                Padding="12,6"
                CornerRadius="8"
                Background="#88000000"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="TimerText"
                       Text="00:00.0"
                       FontSize="28"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8"
                                      ShadowDepth="2" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <!-- The thinking timer (F6), over the drawing and the board; CountdownHud is added
             here in code, placed by the settings' CountdownPosition -->
        <Grid x:Name="CountdownHost" IsHitTestVisible="False"/>

        <!-- Confetti layer (on top of everything) -->
        <Canvas x:Name="ConfettiCanvas"
                Background="Transparent"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
