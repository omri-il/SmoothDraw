<Window x:Class="SmoothDraw.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmoothDraw.Views"
        Title="SmoothDraw Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="0">
    <!-- Opacity 0 until the dot is in its place (Loaded) or the bar at the dot (Expand):
         there is never a frame of either one anywhere else -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Ink" Color="#3B3B46"/>
            <SolidColorBrush x:Key="Edge" Color="#D6D6E0"/>
            <SolidColorBrush x:Key="Hover" Color="#F0F0F5"/>
            <SolidColorBrush x:Key="ActiveFill" Color="#E9E8FF"/>
            <SolidColorBrush x:Key="ActiveInk" Color="#3C34A8"/>

            <!-- Icon button, 34×34. Active tool = lavender pill, darker violet icon. -->
            <Style x:Key="ToolBtn" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ContentTemplate" Value="{StaticResource IconTemplate}"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6E6EE"/>
                                </Trigger>
                                <Trigger Property="local:ToolbarProps.IsActive" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveFill}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ActiveInk}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Clear: the bin turns red under the mouse -->
            <Style x:Key="ClearBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#E03131"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Colour swatch: the colour is the Background, a grey ring (BorderBrush) for
                 the light ones; the active colour gets a violet ring around it -->
            <Style x:Key="SwatchBtn" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="HoverDisc" Width="26" Height="26" Fill="{StaticResource Hover}" Visibility="Hidden"/>
                                <Ellipse x:Name="Ring" Width="26" Height="26" Stroke="{StaticResource ActiveInk}"
                                         StrokeThickness="2" Visibility="Hidden"/>
                                <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}"
                                         Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverDisc" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="local:ToolbarProps.IsActive" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Separator" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="5,8"/>
                <Setter Property="Background" Value="#E6E6EE"/>
            </Style>

            <!-- White, soft shadow. On its own layer behind the content, so the effect
                 never blurs the icons. -->
            <DropShadowEffect x:Key="SoftShadow" Color="#1B1B2A" BlurRadius="14" ShadowDepth="2"
                              Direction="270" Opacity="0.22"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The 10 px margins leave room for the shadow; the placement code counts on the
         dot and the bar having the same room on every side (ToolbarWindow.ShadowRoom) -->
    <Grid x:Name="Root">
        <!-- Expanded toolbar (hidden until the dot is clicked) -->
        <Grid x:Name="MainContent" Margin="10" Visibility="Collapsed">
            <Border CornerRadius="14" Background="White" Effect="{StaticResource SoftShadow}"/>
            <Border CornerRadius="14" Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    MouseLeftButtonDown="Bar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="4,5">

                    <!-- Drag handle -->
                    <ContentControl Content="{StaticResource Icon.Grip}" ContentTemplate="{StaticResource IconTemplate}"
                                    Foreground="#A8A8B6" Width="22" Cursor="SizeAll" VerticalAlignment="Center"
                                    ToolTip="Drag to move" ToolTipService.InitialShowDelay="700"/>

                    <Border Style="{StaticResource Separator}"/>

                    <Button x:Name="BtnMouse" AutomationProperties.AutomationId="BtnMouse" Style="{StaticResource ToolBtn}"
                            Content="{StaticResource Icon.Mouse}" Click="MouseButton_Click" ToolTip="Mouse · Esc"/>
                    <Button x:Name="BtnSelect" Style="{StaticResource ToolBtn}" Tag="Select" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Select}" ToolTip="Select / move"/>

                    <Border Style="{StaticResource Separator}"/>

                    <!-- The pen carries a badge in the ink colour -->
                    <Button x:Name="BtnPen" Style="{StaticResource ToolBtn}" Tag="Pen" Click="ToolButton_Click"
                            ContentTemplate="{x:Null}" ToolTip="Pen · Ctrl+1 (F9)">
                        <Grid Width="20" Height="20">
                            <ContentControl Content="{StaticResource Icon.Pen}" ContentTemplate="{StaticResource IconTemplate}"/>
                            <Ellipse x:Name="PenBadge" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-2,-2" Fill="Red" Stroke="White" StrokeThickness="1.5"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnHighlighter" Style="{StaticResource ToolBtn}" Tag="Highlighter" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Highlighter}" ToolTip="Highlighter · Ctrl+2"/>
                    <Button x:Name="BtnLaser" Style="{StaticResource ToolBtn}" Tag="Laser" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Laser}" ToolTip="Laser · F11"/>
                    <Button x:Name="BtnEraser" Style="{StaticResource ToolBtn}" Tag="Eraser" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Eraser}" ToolTip="Eraser · Ctrl+4"/>

                    <Border Style="{StaticResource Separator}"/>

                    <Button x:Name="BtnArrow" Style="{StaticResource ToolBtn}" Tag="Arrow" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Arrow}" ToolTip="Arrow · Ctrl+5"/>
                    <Button x:Name="BtnRect" Style="{StaticResource ToolBtn}" Tag="Rectangle" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Rectangle}" ToolTip="Rectangle · Ctrl+6"/>
                    <Button x:Name="BtnCircle" Style="{StaticResource ToolBtn}" Tag="Circle" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Circle}" ToolTip="Circle · Ctrl+7"/>
                    <Button x:Name="BtnText" Style="{StaticResource ToolBtn}" Tag="Text" Click="ToolButton_Click"
                            Content="{StaticResource Icon.Text}" ToolTip="Text · Ctrl+8"/>

                    <!-- Options slot: thickness (pen, arrow, rectangle, circle) or text size
                         (text), or nothing. Hidden, never Collapsed: the bar keeps its width,
                         so no button ever slides under the pointer. -->
                    <Grid Width="36">
                        <Button x:Name="BtnThickness" Style="{StaticResource ToolBtn}" ContentTemplate="{x:Null}"
                                Click="ThicknessButton_Click" Visibility="Hidden" ToolTip="Thickness: Medium · click to change">
                            <Line x:Name="ThicknessLine" X1="3" Y1="10" X2="17" Y2="10" Width="20" Height="20"
                                  StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        </Button>
                        <Button x:Name="BtnTextSize" Style="{StaticResource ToolBtn}" ContentTemplate="{x:Null}"
                                Click="TextSizeButton_Click" Visibility="Hidden" ToolTip="Text size: Medium · click to change">
                            <TextBlock x:Name="TextSizeGlyph" Text="A" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource Separator}"/>

                    <Button x:Name="Color1" Style="{StaticResource SwatchBtn}" Tag="1" Click="Color_Click"
                            Background="#FF0000" ToolTip="Red · Ctrl+Alt+1"/>
                    <Button x:Name="Color2" Style="{StaticResource SwatchBtn}" Tag="2" Click="Color_Click"
                            Background="#3278FF" ToolTip="Blue · Ctrl+Alt+2"/>
                    <Button x:Name="Color3" Style="{StaticResource SwatchBtn}" Tag="3" Click="Color_Click"
                            Background="#00C850" ToolTip="Green · Ctrl+Alt+3"/>
                    <Button x:Name="Color4" Style="{StaticResource SwatchBtn}" Tag="4" Click="Color_Click"
                            Background="#FFFFFF" BorderBrush="{StaticResource Edge}" ToolTip="White · Ctrl+Alt+4"/>
                    <Button x:Name="Color5" Style="{StaticResource SwatchBtn}" Tag="5" Click="Color_Click"
                            Background="#FFE600" BorderBrush="{StaticResource Edge}" ToolTip="Yellow · Ctrl+Alt+5"/>

                    <Border Style="{StaticResource Separator}"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource ToolBtn}" Click="UndoButton_Click"
                            Content="{StaticResource Icon.Undo}" ToolTip="Undo · Ctrl+Z" IsEnabled="False"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolBtn}" Click="RedoButton_Click"
                            Content="{StaticResource Icon.Redo}" ToolTip="Redo · Ctrl+Y" IsEnabled="False"/>

                    <Border Style="{StaticResource Separator}"/>

                    <Button x:Name="BtnConfetti" Style="{StaticResource ToolBtn}" Click="ConfettiButton_Click"
                            Content="{StaticResource Icon.Confetti}" Foreground="#F59F00" ToolTip="Confetti"/>
                    <Button x:Name="BtnClear" Style="{StaticResource ClearBtn}" Click="ClearButton_Click"
                            Content="{StaticResource Icon.Trash}" ToolTip="Clear all · F10"/>

                    <Border Style="{StaticResource Separator}"/>

                    <!-- Stops drawing, like the mouse button. Never quits (the tray icon does). -->
                    <Button x:Name="BtnClose" Style="{StaticResource ToolBtn}" Width="30" Click="CloseButton_Click"
                            Content="{StaticResource Icon.Close}" Foreground="#8A8A98"
                            ToolTip="Stop drawing · Esc (to quit SmoothDraw: its tray icon)"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The dot, while not drawing: click = draw, drag = move -->
        <Grid x:Name="MinimalButton" Margin="10" Width="42" Height="42" Cursor="Hand"
              MouseLeftButtonDown="MinimalButton_Click"
              ToolTip="Draw · click     Move · drag" ToolTipService.InitialShowDelay="700">
            <Ellipse Fill="White" Effect="{StaticResource SoftShadow}"/>
            <Ellipse Stroke="{StaticResource Edge}" StrokeThickness="1">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MinimalButton}" Value="True">
                                <Setter Property="Fill" Value="#F4F4F8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Grid Width="20" Height="20">
                <ContentControl Content="{StaticResource Icon.Pen}" ContentTemplate="{StaticResource IconTemplate}"
                                Foreground="{StaticResource Ink}"/>
                <Ellipse x:Name="DotBadge" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-3,-3" Fill="Red" Stroke="White" StrokeThickness="1.5"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
